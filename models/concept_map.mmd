graph TD
    %% Концепти IT-інфраструктури
    Infrastructure["IT-інфраструктура"]
    Hardware["Апаратне забезпечення"]
    Software["Програмне забезпечення"]
    Network["Мережева інфраструктура"]
    Server["Сервер"]
    VM["Віртуальна машина"]
    Hypervisor["Гіпервізор"]
    Container["Контейнер"]
    K8s["Kubernetes"]
    OS["Операційна система"]
    DB["База даних"]
    Router["Маршрутизатор"]
    Switch["Комутатор"]
    Firewall["Мережевий екран"]
    Backup["Резервне копіювання"]
    Monitoring["Моніторинг"]
    Security["Інформаційна безпека"]

    %% Ієрархічні зв'язки (Hierarchical relationships)
    Infrastructure -->|"складається з"| Hardware
    Infrastructure -->|"включає"| Software
    Infrastructure -->|"покладається на"| Network
    
    Hardware -->|"містить"| Server
